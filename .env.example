# Copia este archivo como .env.local y pega cada valor después del "=", sin comillas.
# .env.local nunca se sube al repositorio.

# Dirección donde corre la app (en producción: https://<proyecto>.vercel.app)
APP_BASE_URL=http://localhost:3000

# Auth0 → Applications → tu aplicación → Settings. AUTH0_DOMAIN va sin "https://".
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Se genera con: openssl rand -hex 32
AUTH0_SECRET=

# Neon → botón Connect. En desarrollo usa SIEMPRE la rama dev.
# DATABASE_URL: con "Connection pooling" activado. DATABASE_URL_UNPOOLED: desactivado.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Opcional. Google Search Console → Añadir propiedad → "Etiqueta HTML": pega solo el
# valor de content="...". Sirve para que Google confirme que el sitio es tuyo. No es un secreto.
GOOGLE_SITE_VERIFICATION=

# Vercel → tu proyecto → Storage → Blob. Sirve para subir fotos de producto desde el panel.
# Sin este valor todo funciona igual, salvo el botón "Subir una foto".
BLOB_READ_WRITE_TOKEN=

# Wompi (pasarela de pagos). Panel de comercios de Wompi → Desarrolladores → Llaves y
# "Secretos para integración técnica". Para probar usa las llaves de pruebas
# (pub_test_, prv_test_, test_integrity_, test_events_); para cobrar de verdad, las de
# producción (pub_prod_, prv_prod_, prod_integrity_, prod_events_).
# La URL de eventos que se registra en Wompi es: <APP_BASE_URL>/api/wompi/eventos
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Correos: avisos al cliente cuando su pago se confirma y su pedido cambia de estado, y avisos de
# cotizaciones. Se envían por SMTP con un correo que ya tengas. Sin estos valores todo funciona
# igual, pero no salen correos.
# Con Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación"
# (Cuenta de Google → Seguridad → Contraseñas de aplicaciones). Úsala en SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Remitente que ve el cliente. Ejemplo: Ésman Parfum <tu-correo@gmail.com>
EMAIL_FROM=Ésman Parfum
